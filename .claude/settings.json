{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Skill(replog-toolkit:neue-uebung)",
      "Skill(replog-toolkit:neue-uebung *)"
    ],
    "ask": ["Bash(git push)", "Bash(git push *)"]
  },
  "enabledPlugins": {
    "replog-toolkit@kurs": true
  }
}
